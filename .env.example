# Neon Postgres connection string used by Drizzle
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign session JWTs (use a long random string)
JWT_SECRET="change-me-to-a-long-random-string"

# Brevo transactional email API key (Settings > SMTP & API > API Keys)
BREVO_API_KEY="xkeysib-your-brevo-api-key"

# Verified sender address in Brevo
EMAIL_FROM="hello@heightenthehustle.com"

# Display name shown as the email sender (optional, defaults to "Heighten The Hustle")
EMAIL_FROM_NAME="Heighten The Hustle"

# Public base URL of the app, no trailing slash (used to build links in emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
